# Environment Variables for Flapbitrum Game
# Copy this file to .env.local and fill in your actual values

# ===========================================
# CRITICAL: NEVER COMMIT ACTUAL VALUES TO GIT
# ===========================================

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name

# Redis Configuration (Upstash)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here

# Blockchain Configuration
# Arbitrum RPC URL (get from Alchemy, Infura, or other providers)
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/your_api_key
ALCHEMY_ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/your_api_key
RPC_URL=https://arb-mainnet.g.alchemy.com/v2/your_api_key

# Contract Addresses
NEXT_PUBLIC_TOKEN_REWARD_ADDRESS=0xYourTokenRewardContractAddress

# Server Private Key (CRITICAL - Keep this secure!)
# This is used to sign transactions for token rewards
# Generate a new wallet and fund it with tokens for rewards
SERVER_PRIVATE_KEY=0xYourServerPrivateKeyHere

# API Security
NEXT_PUBLIC_API_SECRET_KEY=your_secret_key_for_api_authentication

# App Configuration
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_URL=https://your-domain.com

# WalletConnect/Reown Configuration (for WalletConnect integration)
NEXT_PUBLIC_REOWN_PROJECT_ID=your_walletconnect_project_id

# ===========================================
# SECURITY NOTES:
# ===========================================
# 1. SERVER_PRIVATE_KEY: This is the most critical secret
#    - Generate a new wallet specifically for this project
#    - Fund it with the tokens you want to distribute as rewards
#    - Never share this key or commit it to version control
#    - Consider using a hardware wallet or secure key management service
#
# 2. Database credentials: Keep MongoDB and Redis credentials secure
#    - Use strong passwords
#    - Enable IP whitelisting if possible
#    - Regularly rotate credentials
#
# 3. RPC URLs: These may contain API keys
#    - Use environment-specific keys
#    - Monitor usage to prevent abuse
#    - Consider rate limiting
#
# 4. Contract addresses: These are public but verify they're correct
#    - Double-check all contract addresses before deployment
#    - Test on testnet first
#
# ===========================================
# DEPLOYMENT CHECKLIST:
# ===========================================
# [ ] All environment variables set in production
# [ ] SERVER_PRIVATE_KEY is secure and funded
# [ ] Database connections working
# [ ] RPC endpoints responding
# [ ] Contract addresses verified
# [ ] No hardcoded secrets in code
# [ ] .env files in .gitignore
